GEMINI_API_KEY=replace-me
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me

# Optional repository API keys
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=

# General
GEMINI_MODEL=gemini-3.1-flash-lite
PAPERS_PER_SOURCE=3
GEMINI_MAX_ATTEMPTS=4
LOG_LEVEL=INFO

# arXiv: Top 3 relevant papers published or updated in D-1 UTC
ARXIV_MAX_RESULTS_PER_QUERY=100
ARXIV_TERMS_PER_QUERY=12
ARXIV_TIMEOUT_SECONDS=30
ARXIV_MAX_ATTEMPTS=4
ARXIV_MIN_REQUEST_INTERVAL_SECONDS=3

# Semantic Scholar: Top 3 relevant papers published in the last 30 calendar days
SEMANTIC_SCHOLAR_MAX_RESULTS_PER_QUERY=50
SEMANTIC_SCHOLAR_TERMS_PER_QUERY=8
SEMANTIC_SCHOLAR_TIMEOUT_SECONDS=30
SEMANTIC_SCHOLAR_MAX_ATTEMPTS=4
SEMANTIC_SCHOLAR_MIN_REQUEST_INTERVAL_SECONDS=1

# OpenAlex: semantic discovery + thematic gate + DOI date validation + citation ranking
OPENALEX_LOOKBACK_DAYS=60
OPENALEX_MAX_RESULTS_PER_QUERY=50
OPENALEX_TIMEOUT_SECONDS=30
OPENALEX_MAX_ATTEMPTS=4
OPENALEX_MIN_REQUEST_INTERVAL_SECONDS=1
OPENALEX_MIN_RELEVANCE_SCORE=10
OPENALEX_VALIDATION_MAX_CANDIDATES=25
OPENALEX_REQUIRE_VALIDATED_DATE=true
OPENALEX_REQUIRE_DAY_PRECISION=true
OPENALEX_BIBLIOGRAPHIC_TIMEOUT_SECONDS=20
OPENALEX_BIBLIOGRAPHIC_MAX_ATTEMPTS=3
OPENALEX_BIBLIOGRAPHIC_MIN_REQUEST_INTERVAL_SECONDS=0.5

# Telegram
TELEGRAM_MAX_ATTEMPTS=4
TELEGRAM_TIMEOUT_SECONDS=20
TELEGRAM_FORCE_IPV4=false
